<div class="dispatch-grid-wrapper flex flex-col h-full w-full bg-gray-950 text-gray-100 p-4 space-y-4">
    {{!-- Top Toolbar --}}
    <div class="dispatch-grid-toolbar flex-shrink-0 flex flex-col xl:flex-row items-start xl:items-center justify-between gap-3 bg-gray-900/90 border border-gray-800 rounded-xl p-3 shadow-lg relative z-30">
        <div class="flex items-center space-x-3">
            <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-blue-600/20 text-blue-400 border border-blue-500/30">
                <FaIcon @icon="table-cells" class="text-base" />
            </div>
            <div>
                <div class="flex items-center space-x-2">
                    <h2 class="text-base font-bold text-white tracking-wide">Dispatch Grid</h2>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30">
                        {{this.gridRows.length}} Orders
                    </span>
                </div>
                <p class="text-xs text-gray-400">Live operational manifest &amp; dispatch status matrix</p>
            </div>
        </div>

        {{!-- Search & Filters & Date Controls --}}
        <div class="flex flex-wrap items-center gap-2 w-full xl:w-auto">
            {{!-- Search Input --}}
            <div class="relative flex-1 sm:w-56 sm:flex-initial">
                <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-gray-400">
                    <FaIcon @icon="search" class="text-xs" />
                </div>
                <Input
                    @type="text"
                    @value={{this.searchQuery}}
                    placeholder="Search passenger, driver..."
                    class="form-input form-input-sm w-full pl-8 bg-gray-950/80 border-gray-700 text-gray-100 placeholder-gray-500 text-xs rounded-lg focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
                {{#if this.searchQuery}}
                    <button
                        type="button"
                        class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-gray-400 hover:text-white text-xs"
                        {{on "click" this.clearSearch}}
                    >
                        <FaIcon @icon="times-circle" />
                    </button>
                {{/if}}
            </div>

            {{!-- Quick Status Filter Tabs (7 Canonical Stages) --}}
            <div class="flex items-center bg-gray-950 p-0.5 rounded-lg border border-gray-800 text-xs overflow-x-auto">
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'all') 'bg-blue-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "all")}}
                >
                    <span>All</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'all') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.all}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'created') 'bg-gray-700 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "created")}}
                >
                    <span>Created</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'created') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.created}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'dispatched') 'bg-blue-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "dispatched")}}
                >
                    <span>Dispatched</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'dispatched') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.dispatched}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'enroute_pickup') 'bg-amber-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "enroute_pickup")}}
                >
                    <span>En Route</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'enroute_pickup') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.enroute_pickup}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'on_location') 'bg-purple-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "on_location")}}
                >
                    <span>On Location</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'on_location') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.on_location}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'pob') 'bg-orange-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "pob")}}
                >
                    <span>POB</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'pob') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.pob}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'completed') 'bg-emerald-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "completed")}}
                >
                    <span>Completed</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'completed') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.completed}}
                    </span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.statusFilter 'canceled') 'bg-red-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setStatusFilter "canceled")}}
                >
                    <span>Canceled</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold {{if (eq this.statusFilter 'canceled') 'bg-black/30 text-white border border-white/20' 'bg-gray-800 text-gray-400 border border-gray-700/50'}}">
                        {{this.statusCounts.canceled}}
                    </span>
                </button>
            </div>

            {{!-- Date Control Cluster --}}
            <div class="flex items-center bg-gray-950 p-0.5 rounded-lg border border-gray-800 text-xs space-x-1">
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.dateFilterMode 'today') 'bg-blue-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setDateMode "today")}}
                >
                    <FaIcon @icon="calendar-day" class="text-[10px]" />
                    <span>Today</span>
                </button>
                <button
                    type="button"
                    class="px-2.5 py-1 rounded-md transition-colors font-medium flex items-center space-x-1.5 {{if (eq this.dateFilterMode 'all') 'bg-blue-600 text-white shadow' 'text-gray-400 hover:text-white'}}"
                    {{on "click" (fn this.setDateMode "all")}}
                >
                    <FaIcon @icon="calendar-alt" class="text-[10px]" />
                    <span>All</span>
                </button>
                <div class="relative flex items-center pl-1 border-l border-gray-800">
                    <input
                        type="date"
                        value={{this.customSelectedDate}}
                        class="px-2 py-0.5 text-xs rounded bg-gray-900 border {{if (eq this.dateFilterMode 'custom') 'border-blue-500 text-white ring-1 ring-blue-500' 'border-gray-700 text-gray-300'}} focus:outline-none focus:border-blue-500"
                        title="Filter by custom date"
                        {{on "input" this.onCustomDateChange}}
                        {{on "change" this.onCustomDateChange}}
                    />
                </div>
            </div>
        </div>
    </div>

    {{!-- Compact Spreadsheet Table Container --}}
    <div class="dispatch-grid-table-container flex-1 min-h-0 overflow-x-auto overflow-y-auto rounded-xl border border-gray-800 bg-gray-900/60 shadow-xl custom-scrollbar relative z-10">
        <table class="w-full text-left border-collapse min-w-[900px]">
            <thead class="dispatch-grid-thead sticky top-0 z-20 bg-[#111827] border-b border-gray-700 shadow-md">
                <tr class="bg-[#111827] border-b border-gray-700 h-9">
                    <th class="dispatch-grid-th py-2 px-3.5 w-28 text-[#F9FAFB] font-bold text-xs uppercase tracking-wider bg-[#111827]">Time</th>
                    <th class="dispatch-grid-th py-2 px-3.5 w-48 text-[#F9FAFB] font-bold text-xs uppercase tracking-wider bg-[#111827]">Passenger</th>
                    <th class="dispatch-grid-th py-2 px-3.5 w-36 text-[#F9FAFB] font-bold text-xs uppercase tracking-wider bg-[#111827]">Phone</th>
                    <th class="dispatch-grid-th py-2 px-3.5 min-w-[260px] text-[#F9FAFB] font-bold text-xs uppercase tracking-wider bg-[#111827]">Route</th>
                    <th class="dispatch-grid-th py-2 px-3.5 w-44 text-[#F9FAFB] font-bold text-xs uppercase tracking-wider bg-[#111827]">Chauffeur</th>
                    <th class="dispatch-grid-th py-2 px-3.5 w-28 text-center text-[#F9FAFB] font-bold text-xs uppercase tracking-wider bg-[#111827]">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-800/40 text-xs relative z-1">
                {{#if this.gridRows.length}}
                    {{#each this.gridRows as |item|}}
                        <tr
                            class="dispatch-grid-row h-9 max-h-9 hover:bg-gray-800/60 border-b border-gray-800/40 transition-colors duration-100 cursor-pointer select-none relative z-1 {{item.rowClass}}"
                            data-status="{{item.order.status}}"
                            {{on "click" (fn this.openOrderDetails item.order)}}
                        >
                            {{!-- Time --}}
                            <td class="py-1 px-3.5 align-middle whitespace-nowrap">
                                <div class="font-mono text-xs font-semibold text-gray-200 flex items-center space-x-1.5" title="Scheduled / Pickup Time">
                                    <FaIcon @icon="clock" class="text-[10px] text-gray-400" />
                                    <span>{{item.formattedTime}}</span>
                                </div>
                            </td>

                            {{!-- Passenger --}}
                            <td class="py-1 px-3.5 align-middle whitespace-nowrap">
                                <div class="truncate max-w-[180px] font-medium text-white text-xs" title={{item.passenger.name}}>
                                    {{item.passenger.name}}
                                </div>
                            </td>

                            {{!-- Phone --}}
                            <td class="py-1 px-3.5 align-middle whitespace-nowrap">
                                {{#if item.passenger.phone}}
                                    <a
                                        href="tel:{{item.passenger.phone}}"
                                        class="text-blue-400 hover:text-blue-300 hover:underline font-mono text-xs"
                                        title="Call {{item.passenger.phone}}"
                                        {{on "click" this.stopEventPropagation}}
                                    >
                                        {{item.passenger.phone}}
                                    </a>
                                {{else}}
                                    <span class="text-gray-500 italic text-xs">--</span>
                                {{/if}}
                            </td>

                            {{!-- Route --}}
                            <td class="py-1 px-3.5 align-middle">
                                <div class="truncate max-w-lg text-xs flex items-center space-x-1.5" title={{item.route.text}}>
                                    <span class="truncate font-medium text-gray-200">{{item.route.pickup}}</span>
                                    <span class="text-blue-400 font-bold shrink-0">➔</span>
                                    <span class="truncate text-gray-400">{{item.route.dropoff}}</span>
                                </div>
                            </td>

                            {{!-- Chauffeur --}}
                            <td class="py-1 px-3.5 align-middle whitespace-nowrap">
                                {{#if item.driver.assigned}}
                                    <div class="truncate max-w-[160px] font-medium text-gray-200 text-xs" title={{item.driver.name}}>
                                        {{item.driver.name}}
                                    </div>
                                {{else}}
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-800 text-gray-400 border border-gray-700/60">
                                        Unassigned
                                    </span>
                                {{/if}}
                            </td>

                            {{!-- Status --}}
                            <td class="py-1 px-3.5 align-middle whitespace-nowrap text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold tracking-wider uppercase {{item.statusBadge.class}}" data-status="{{item.order.status}}">
                                    {{item.statusBadge.title}}
                                </span>
                            </td>
                        </tr>
                    {{/each}}
                {{else}}
                    <tr>
                        <td colspan="6" class="py-16 text-center text-gray-400">
                            <div class="flex flex-col items-center justify-center space-y-2">
                                <div class="w-10 h-10 rounded-full bg-gray-900 border border-gray-800 flex items-center justify-center text-gray-500">
                                    <FaIcon @icon="table-cells" class="text-base" />
                                </div>
                                <div class="text-sm font-semibold text-white">No orders found in Dispatch Grid</div>
                                <div class="text-xs text-gray-400 max-w-sm">
                                    {{#if this.searchQuery}}
                                        No orders matching "{{this.searchQuery}}". Try clearing the search filter.
                                    {{else if (eq this.dateFilterMode "today")}}
                                        No orders scheduled for today ({{this.todayDateString}}) matching the active filter.
                                    {{else if (eq this.dateFilterMode "custom")}}
                                        No orders scheduled for {{this.customSelectedDate}} matching the active filter.
                                    {{else}}
                                        No orders match the selected filter.
                                    {{/if}}
                                </div>
                            </div>
                        </td>
                    </tr>
                {{/if}}
            </tbody>
        </table>
    </div>
</div>
