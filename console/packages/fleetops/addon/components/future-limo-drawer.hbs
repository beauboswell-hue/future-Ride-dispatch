{{#if (or @isOpen this.isFutureLimoDrawerOpen)}}
    {{! Backdrop }}
    <div 
        class="fixed inset-0 bg-gray-900 bg-opacity-50 z-40 transition-opacity future-limo-drawer-backdrop"
        style="z-index: 9998;"
        {{on "click" (or @onClose this.closeFutureLimoDrawer)}}
    ></div>

    {{! Slide-out Drawer Panel }}
    <div class="fixed inset-y-0 right-0 max-w-full flex pl-10 z-50 pointer-events-auto" style="z-index: 9999;">
        <div class="w-[50vw] min-w-[600px] max-w-[850px] max-w-[90vw] h-full bg-gray-900 shadow-2xl border-l border-gray-800 flex flex-col future-limo-drawer-panel" style="width: 50vw; min-width: 600px; max-width: 850px; height: 100%;" role="dialog" aria-modal="true" aria-label="Booking">
            {{! Header }}
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-800 bg-gray-950">
                <div class="flex items-center space-x-2">
                    <span class="font-semibold text-white text-sm">Booking</span>
                    <span class="text-xs text-gray-400">({{this.bookingUrl}})</span>
                </div>
                <button 
                    type="button" 
                    class="text-gray-400 hover:text-white p-1 rounded hover:bg-gray-800 transition-colors focus:outline-none" 
                    aria-label="Close Booking"
                    {{on "click" (or @onClose this.closeFutureLimoDrawer)}}
                >
                    <FaIcon @icon="times" />
                </button>
            </div>

            {{! Iframe Body }}
            <div class="flex-1 w-full h-full relative overflow-hidden bg-gray-950">
                <iframe 
                    src={{this.bookingUrl}}
                    title={{this.bookingTitle}}
                    class="w-full h-full border-0"
                    style="width: 100%; height: 100%; min-height: 100%;"
                    allow="geolocation; camera; microphone"
                    sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-modals"
                ></iframe>
            </div>
        </div>
    </div>
{{/if}}
